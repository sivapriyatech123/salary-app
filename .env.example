# SalarySplit Environment Variables Example

# Frontend API URL
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Credentials (Optional - Falls back to LocalStorage Demo Mode if empty)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Server Configuration
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/salarysplit
